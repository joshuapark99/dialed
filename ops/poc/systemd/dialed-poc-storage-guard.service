[Unit]
Description=Stop Dialed POC telemetry before observability storage exhaustion

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/dialed/bin/storage-guard
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
StandardError=journal
SyslogLevel=crit
TimeoutStartSec=30s
