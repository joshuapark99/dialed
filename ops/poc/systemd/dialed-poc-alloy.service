[Unit]
Description=Collect Dialed POC host metrics and journal logs
Requires=dialed-poc-observability.service
After=dialed-poc-observability.service

[Service]
Type=simple
User=alloy
Group=alloy
SupplementaryGroups=adm systemd-journal
ExecStart=/usr/bin/alloy run --server.http.listen-addr=127.0.0.1:12345 --storage.path=/run/dialed-observability/alloy /opt/dialed/observability/alloy/config.alloy
Restart=on-failure
RestartSec=5s
MemoryMax=256M
CPUQuota=50%
Nice=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
RuntimeDirectory=dialed-observability/alloy dialed-observability/textfile
RuntimeDirectoryMode=0750
ReadWritePaths=/run/dialed-observability/alloy
ReadOnlyPaths=/opt/dialed/observability/alloy/config.alloy /run/dialed-observability/textfile /var/log/journal /run/log/journal

[Install]
WantedBy=multi-user.target
