[Unit]
Description=Snapshot allowlisted Dialed POC operational metrics
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/opt/dialed/bin/observe
UMask=0027
CapabilityBoundingSet=CAP_CHOWN
AmbientCapabilities=
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadOnlyPaths=/var/lib/dialed /run/systemd/private /var/run/docker.sock
TimeoutStartSec=30s
