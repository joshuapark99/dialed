# Exact public application origin, without a trailing slash.
APP_URL=

# Generate URL-safe random secrets; BETTER_AUTH_SECRET must be at least 32 characters.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# PostgreSQL credentials. POSTGRES_PASSWORD must be URL-safe because Compose builds DATABASE_URL.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Remotely managed Cloudflare named-tunnel token.
TUNNEL_TOKEN=

# Absolute SSD-backed paths. Keep backups outside the live PostgreSQL directory.
DIALED_DATA_DIR=
DIALED_BACKUP_DIR=
