# Exact public application origin, without a trailing slash.
APP_URL=

# Generate URL-safe random secrets; BETTER_AUTH_SECRET must be at least 32 characters.
BETTER_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SYNC_OPERATION_QUOTA=50000

# PostgreSQL credentials. POSTGRES_PASSWORD must be URL-safe because Compose builds DATABASE_URL.
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Remotely managed Cloudflare named-tunnel token.
TUNNEL_TOKEN=

# Absolute SSD-backed paths. Keep backups outside the live PostgreSQL directory.
DIALED_DATA_DIR=
DIALED_BACKUP_DIR=

# Absolute, dedicated SSD-backed observability directory. Do not overlap data or backups.
DIALED_OBSERVABILITY_DIR=

# Bounded observability storage limits. Use 5368709120 (5 GiB) and 10737418240 (10 GiB) unless capacity planning says otherwise.
DIALED_OBSERVABILITY_MAX_BYTES=
DIALED_OBSERVABILITY_MIN_FREE_BYTES=

# Grafana local administrator. The password must be at least 32 characters.
GRAFANA_ADMIN_USER=
GRAFANA_ADMIN_PASSWORD=
