#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck source=common
. "$SCRIPT_DIR/common"

require_positive_decimal() {
  setting_name=$1
  setting_value=$2
  case "$setting_value" in
    '' | *[!0-9]*) die "$setting_name must be a positive decimal integer" ;;
  esac
  [ "$setting_value" -gt 0 ] 2>/dev/null ||
    die "$setting_name must be a positive decimal integer"
}

require_decimal() {
  setting_name=$1
  setting_value=$2
  case "$setting_value" in
    '' | *[!0-9]*) die "$setting_name must be a decimal integer" ;;
  esac
}

require_safe_directory() {
  directory_name=$1
  directory_value=$2
  require_absolute_path "$directory_name" "$directory_value"
  case "$directory_value" in
    *'
'*) die "$directory_name must not contain a newline" ;;
  esac
  [ -d "$directory_value" ] || die "$directory_value must be an existing directory"
  [ ! -L "$directory_value" ] || die "$directory_value must not be a symbolic link"
}

load_poc_env
require_value DIALED_OBSERVABILITY_DIR "${DIALED_OBSERVABILITY_DIR:-}"
require_value DIALED_OBSERVABILITY_MAX_BYTES "${DIALED_OBSERVABILITY_MAX_BYTES:-}"
require_value DIALED_OBSERVABILITY_MIN_FREE_BYTES "${DIALED_OBSERVABILITY_MIN_FREE_BYTES:-}"

observability_directory=$DIALED_OBSERVABILITY_DIR
maximum_bytes=$DIALED_OBSERVABILITY_MAX_BYTES
minimum_free_bytes=$DIALED_OBSERVABILITY_MIN_FREE_BYTES
sentinel=$observability_directory/INGESTION_STOPPED

require_safe_directory DIALED_OBSERVABILITY_DIR "$observability_directory"
require_positive_decimal DIALED_OBSERVABILITY_MAX_BYTES "$maximum_bytes"
require_positive_decimal DIALED_OBSERVABILITY_MIN_FREE_BYTES "$minimum_free_bytes"

used_bytes=$(du -sB1 "$observability_directory" | awk 'NR == 1 { print $1 }')
free_bytes=$(df -PB1 "$observability_directory" | awk 'NR == 2 { print $4 }')
require_decimal observed_directory_bytes "$used_bytes"
require_decimal observed_free_bytes "$free_bytes"

if [ "$used_bytes" -ge "$maximum_bytes" ]; then
  reason=used_bytes
  observed_bytes=$used_bytes
  threshold_bytes=$maximum_bytes
elif [ "$free_bytes" -lt "$minimum_free_bytes" ]; then
  reason=free_bytes
  observed_bytes=$free_bytes
  threshold_bytes=$minimum_free_bytes
else
  exit 0
fi

if ! { [ -f "$sentinel" ] && [ ! -L "$sentinel" ] &&
  grep -Fqx "reason=$reason" "$sentinel"; }; then
  umask 077
  temporary=$(mktemp "$observability_directory/.INGESTION_STOPPED.XXXXXX")
  printf '%s\n' \
    "reason=$reason" \
    "observed_bytes=$observed_bytes" \
    "threshold_bytes=$threshold_bytes" \
    "timestamp=$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >"$temporary"
  chmod 0600 "$temporary"
  mv "$temporary" "$sentinel"
fi

critical() {
  printf 'dialed-poc-storage-guard: CRITICAL: %s\n' "$1" >&2
}

if ! alloy_state=$(systemctl show --property=ActiveState --value dialed-poc-alloy.service); then
  critical 'could not determine dialed-poc-alloy.service state; ingestion stop is unverified'
  exit 1
fi

case "$alloy_state" in
  inactive | failed) exit 0 ;;
  active | activating | reloading | deactivating) ;;
  *)
    critical 'could not determine dialed-poc-alloy.service state; ingestion stop is unverified'
    exit 1
    ;;
esac

critical 'observability storage threshold is active; stopping dialed-poc-alloy.service'
if ! systemctl stop dialed-poc-alloy.service; then
  critical 'failed to stop dialed-poc-alloy.service; the storage guard will retry'
  exit 1
fi

if ! alloy_state=$(systemctl show --property=ActiveState --value dialed-poc-alloy.service); then
  critical 'could not verify dialed-poc-alloy.service after stop; the storage guard will retry'
  exit 1
fi
case "$alloy_state" in
  inactive | failed) ;;
  *)
    critical 'dialed-poc-alloy.service is not stopped; the storage guard will retry'
    exit 1
    ;;
esac
