#!/bin/sh
set -eu

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
# shellcheck source=common
. "$SCRIPT_DIR/common"

reason=${1:-scheduled}
case "$reason" in
  scheduled | predeploy) ;;
  *) die "backup reason must be scheduled or predeploy" ;;
esac

umask 077
acquire_lock
load_poc_env
load_active_state
require_value DIALED_BACKUP_DIR "${DIALED_BACKUP_DIR:-}"
require_value POSTGRES_USER "${POSTGRES_USER:-}"
require_value POSTGRES_DB "${POSTGRES_DB:-}"
require_value APP_REVISION "${APP_REVISION:-}"

require_absolute_path "DIALED_BACKUP_DIR" "$DIALED_BACKUP_DIR"
case "$APP_REVISION" in
  *[!0-9a-f]* | ??????????????????????????????????????? | ?????????????????????????????????????????*)
    die "APP_REVISION must be a lowercase 40-character Git revision"
    ;;
esac

mkdir -p "$DIALED_BACKUP_DIR"
[ -d "$DIALED_BACKUP_DIR" ] || die "$DIALED_BACKUP_DIR is not a directory"
[ ! -L "$DIALED_BACKUP_DIR" ] ||
  die "$DIALED_BACKUP_DIR must not be a symbolic link"

timestamp=$(date -u +%Y%m%dT%H%M%SZ)
temporary=$(mktemp "$DIALED_BACKUP_DIR/.dialed-backup.XXXXXX")
cleanup() {
  rm -f -- "$temporary"
}
trap cleanup 0 1 2 15

if ! compose exec -T postgres pg_dump \
  -U "$POSTGRES_USER" \
  -d "$POSTGRES_DB" \
  -Fc \
  --no-owner \
  --no-acl >"$temporary"; then
  die "pg_dump failed; no backup was promoted"
fi

[ -s "$temporary" ] || die "pg_dump produced an empty backup"

archive="$DIALED_BACKUP_DIR/dialed-$timestamp-$APP_REVISION-$reason.dump"
mv "$temporary" "$archive"
trap - 0 1 2 15

if [ "$reason" = "scheduled" ]; then
  find "$DIALED_BACKUP_DIR" \
    -maxdepth 1 \
    -type f \
    -name 'dialed-*-scheduled.dump' \
    -printf '%f\n' |
    sort -r |
    awk 'NR > 14' |
    while IFS= read -r expired; do
      [ -n "$expired" ] && rm -f -- "$DIALED_BACKUP_DIR/$expired"
    done
fi

printf '%s\n' "$archive"
