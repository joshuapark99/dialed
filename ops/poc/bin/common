#!/bin/sh
set -eu

die() {
  printf 'dialed-poc: %s\n' "$*" >&2
  exit 1
}

require_absolute_path() {
  path_name=$1
  path_value=$2
  case "$path_value" in
    /*) ;;
    *) die "$path_name must be an absolute path" ;;
  esac
}

require_value() {
  value_name=$1
  value_value=$2
  [ -n "$value_value" ] || die "$value_name is required"
}

require_positive_decimal() {
  setting_name=$1
  setting_value=$2
  case "$setting_value" in
    '' | *[!0-9]*) die "$setting_name must be a positive decimal integer" ;;
  esac
  [ "$setting_value" -gt 0 ] 2>/dev/null ||
    die "$setting_name must be a positive decimal integer"
}

require_dedicated_storage_path() {
  storage_name=$1
  storage_path=$2
  relative_path=${storage_path#/}
  case "$relative_path" in
    */*) ;;
    *) die "$storage_name must be a dedicated nested path, not $storage_path" ;;
  esac
}

require_disjoint_paths() {
  left_name=$1
  left_path=$2
  right_name=$3
  right_path=$4
  case "$right_path" in
    "$left_path" | "$left_path"/*)
      die "$left_name and $right_name must be separate dedicated directories"
      ;;
  esac
  case "$left_path" in
    "$right_path" | "$right_path"/*)
      die "$left_name and $right_name must be separate dedicated directories"
      ;;
  esac
}

require_grafana_admin_user() {
  case "$1" in
    '' | *[[:space:][:cntrl:]]*)
      die "GRAFANA_ADMIN_USER must not contain whitespace or control characters"
      ;;
  esac
}

validate_observability_environment() {
  command -v realpath >/dev/null 2>&1 || die "realpath is required"
  for required_name in \
    DIALED_DATA_DIR \
    DIALED_BACKUP_DIR \
    DIALED_OBSERVABILITY_DIR \
    GRAFANA_ADMIN_USER \
    GRAFANA_ADMIN_PASSWORD \
    DIALED_OBSERVABILITY_MAX_BYTES \
    DIALED_OBSERVABILITY_MIN_FREE_BYTES; do
    eval "required_value=\${$required_name:-}"
    require_value "$required_name" "$required_value"
  done

  require_grafana_admin_user "$GRAFANA_ADMIN_USER"
  [ "${#GRAFANA_ADMIN_PASSWORD}" -ge 32 ] ||
    die "GRAFANA_ADMIN_PASSWORD must contain at least 32 characters"
  require_positive_decimal DIALED_OBSERVABILITY_MAX_BYTES "$DIALED_OBSERVABILITY_MAX_BYTES"
  require_positive_decimal DIALED_OBSERVABILITY_MIN_FREE_BYTES "$DIALED_OBSERVABILITY_MIN_FREE_BYTES"

  require_absolute_path DIALED_DATA_DIR "$DIALED_DATA_DIR"
  require_absolute_path DIALED_BACKUP_DIR "$DIALED_BACKUP_DIR"
  require_absolute_path DIALED_OBSERVABILITY_DIR "$DIALED_OBSERVABILITY_DIR"
  data_path=$(realpath -m -- "$DIALED_DATA_DIR")
  backup_path=$(realpath -m -- "$DIALED_BACKUP_DIR")
  observability_path=$(realpath -m -- "$DIALED_OBSERVABILITY_DIR")
  require_dedicated_storage_path DIALED_DATA_DIR "$data_path"
  require_dedicated_storage_path DIALED_BACKUP_DIR "$backup_path"
  require_dedicated_storage_path DIALED_OBSERVABILITY_DIR "$observability_path"
  require_disjoint_paths DIALED_DATA_DIR "$data_path" DIALED_BACKUP_DIR "$backup_path"
  require_disjoint_paths DIALED_DATA_DIR "$data_path" DIALED_OBSERVABILITY_DIR "$observability_path"
  require_disjoint_paths DIALED_BACKUP_DIR "$backup_path" DIALED_OBSERVABILITY_DIR "$observability_path"
}

require_alloy_version() {
  version_token=$(printf '%s\n' "$1" | awk '
    {
      for (field = 1; field <= NF; field += 1) {
        if ($field == "version") {
          version = $(field + 1)
          sub(/^v/, "", version)
          print version
          exit
        }
      }
    }
  ')
  case "$version_token" in
    1.19.0) ;;
    *) die "Grafana Alloy 1.19.0 is required; found $version_token" ;;
  esac
}

validate_owned_file() {
  file_path=$1
  require_absolute_path "file" "$file_path"
  [ -f "$file_path" ] || die "$file_path must be a regular file"
  [ ! -L "$file_path" ] || die "$file_path must not be a symbolic link"
  [ "$(stat -c '%u' "$file_path")" = "$(id -u)" ] ||
    die "$file_path must be owned by the current user"
  [ -z "$(find "$file_path" -prune -perm /022 -print)" ] ||
    die "$file_path must not be group- or world-writable"
}

validate_secret_file() {
  file_path=$1
  validate_owned_file "$file_path"
  [ -z "$(find "$file_path" -prune -perm /077 -print)" ] ||
    die "$file_path must be readable only by its owner"
}

load_poc_env() {
  DIALED_ENV_FILE=${DIALED_ENV_FILE:-/etc/dialed/poc.env}
  require_absolute_path "DIALED_ENV_FILE" "$DIALED_ENV_FILE"
  validate_secret_file "$DIALED_ENV_FILE"
  set -a
  # shellcheck disable=SC1090 -- validated, root-owned runtime configuration.
  . "$DIALED_ENV_FILE"
  set +a
}

load_active_state() {
  DIALED_ACTIVE_STATE=${DIALED_ACTIVE_STATE:-/var/lib/dialed/active.env}
  require_absolute_path "DIALED_ACTIVE_STATE" "$DIALED_ACTIVE_STATE"
  validate_secret_file "$DIALED_ACTIVE_STATE"
  set -a
  # shellcheck disable=SC1090 -- validated, root-owned deployment state.
  . "$DIALED_ACTIVE_STATE"
  set +a
}

acquire_lock() {
  if [ "${DIALED_LOCK_HELD:-0}" = "1" ]; then
    return
  fi
  DIALED_LOCK_FILE=${DIALED_LOCK_FILE:-/run/lock/dialed-poc.lock}
  require_absolute_path "DIALED_LOCK_FILE" "$DIALED_LOCK_FILE"
  exec 9>"$DIALED_LOCK_FILE"
  flock -n 9 || exit 0
}

compose() {
  DIALED_COMPOSE_FILE=${DIALED_COMPOSE_FILE:-/opt/dialed/compose.poc.yaml}
  require_absolute_path "DIALED_COMPOSE_FILE" "$DIALED_COMPOSE_FILE"
  validate_owned_file "$DIALED_COMPOSE_FILE"
  docker compose --env-file "$DIALED_ENV_FILE" -f "$DIALED_COMPOSE_FILE" "$@"
}
